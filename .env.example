NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=vinayak
ANTHROPIC_API_KEY=
# Optional: route Anthropic calls through a router/proxy (default: api.anthropic.com)
ANTHROPIC_BASE_URL=
# Optional: set to "bearer" if the router wants `Authorization: Bearer <key>` instead of x-api-key
ANTHROPIC_AUTH_SCHEME=
# Optional: override the default model (claude-sonnet-4-5)
ANTHROPIC_MODEL=
# Optional: ElevenLabs speech-to-text for voice intake (without it, send a `transcript` string)
ELEVENLABS_API_KEY=
